# ============================================================================
# Instagram Autonomous AI Agent - Environment Configuration (.env)
# ============================================================================

# 1. Telegram Bot & Owner Access Control
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_OWNER_ID="123456789"

# 2. Optional Telegram User Account (Telethon) for Source Channel Monitoring
TG_API_ID="0"
TG_API_HASH=""
TG_SESSION_PATH="data/telethon_user.session"

# 3. Dynamic OpenAI-Compatible AI Configuration (Changeable at runtime via Telegram)
AI_API_BASE_URL="https://api.openai.com/v1"
AI_API_KEY="sk-your-openai-compatible-api-key"
AI_MODEL_NAME="gpt-4o-mini"
AI_TEMPERATURE="0.4"
AI_MAX_TOKENS="1500"
AI_TIMEOUT="45"

# 4. Instagram Session Configuration (Instagrapi Primary Engine)
IG_SESSION_PATH="/tmp/ig_api/session.json"
IG_ACCOUNTS_DIR="data/ig_sessions"
SESSION_ENCRYPTION_KEY=""

# 5. Consistent Proxy Configuration for Instagram Session
PROXY_ENABLED="false"
PROXY_URL="http://127.0.0.1:8080"
PROXY_USERNAME=""
PROXY_PASSWORD=""

# 6. Independent Web Search Engine Configuration
SEARCH_PROVIDER="duckduckgo"
SEARCH_API_KEY=""
SEARCH_MAX_RESULTS="5"

# 7. Storage, Memory (SQLite / PostgreSQL Ready) & VPS Resource Constraints
DATABASE_URL="sqlite:///data/agent_memory.db"
TEMP_MEDIA_DIR="data/temp_media"
MAX_TEMP_STORAGE_MB="350"
LOG_FILE_PATH="logs/agent.log"
AUTO_PUBLISH_REQUIRE_APPROVAL="true"
